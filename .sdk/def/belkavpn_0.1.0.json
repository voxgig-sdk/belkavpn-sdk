{
  "openapi": "3.0.3",
  "info": {
    "title": "BelkaVPN API",
    "description": "The BelkaVPN API allows users to bypass geographical restrictions and website filters, ensuring access to blocked social media platforms while traveling abroad. It provides functionality for retrieving a list of proxy servers and managing connection preferences.",
    "version": "1.0.0",
    "contact": {
      "url": "https://github.com/l0v3m0n3y/belkavpn"
    }
  },
  "servers": [
    {
      "url": "https://api.belkavpn.com",
      "description": "BelkaVPN API Server"
    }
  ],
  "paths": {
    "/socks": {
      "get": {
        "summary": "Get SOCKS5 proxy list",
        "description": "Retrieves a list of available SOCKS5 proxy servers that can be used to bypass geographical restrictions and website filters.",
        "operationId": "getSocks5List",
        "tags": [
          "Proxy Servers"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the list of SOCKS5 proxy servers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "host": {
                        "type": "string",
                        "description": "The hostname or IP address of the proxy server",
                        "example": "proxy1.belkavpn.com"
                      },
                      "port": {
                        "type": "integer",
                        "description": "The port number of the proxy server",
                        "example": 1080
                      },
                      "country": {
                        "type": "string",
                        "description": "The country where the proxy server is located",
                        "example": "US"
                      },
                      "status": {
                        "type": "string",
                        "description": "The operational status of the proxy server",
                        "enum": [
                          "active",
                          "inactive",
                          "maintenance"
                        ],
                        "example": "active"
                      }
                    }
                  }
                },
                "examples": {
                  "proxyList": {
                    "summary": "Example proxy server list",
                    "value": [
                      {
                        "host": "proxy1.belkavpn.com",
                        "port": 1080,
                        "country": "US",
                        "status": "active"
                      },
                      {
                        "host": "proxy2.belkavpn.com",
                        "port": 1080,
                        "country": "UK",
                        "status": "active"
                      }
                    ]
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message describing what went wrong",
                      "example": "Failed to retrieve proxy server list"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message indicating service unavailability",
                      "example": "Service temporarily unavailable"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Proxy Servers",
      "description": "Operations related to retrieving and managing proxy server information"
    }
  ],
  "externalDocs": {
    "description": "BelkaVPN API Documentation",
    "url": "https://github.com/l0v3m0n3y/belkavpn"
  }
}
